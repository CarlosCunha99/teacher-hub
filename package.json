{
  "name": "teacher-hub",
  "version": "0.1.0",
  "description": "Teacher Hub — a platform for teachers to share and discover classroom resources.",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
