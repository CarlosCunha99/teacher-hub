# Application environment
# Copy this file to .env.local and fill in real values before running locally.
# .env.local is gitignored and must never be committed.
# Real variables for database, authentication, etc. arrive in issues #2 and #3.

APP_ENV=development

# Database connection (added in issue #3 — PostgreSQL schema)
# DATABASE_URL=postgresql://user:password@localhost:5432/teacher_hub

# Resource download feature (issue #11)
# Override the directory where resources.json and audit.json are stored.
# Defaults to "data/" (relative to project root). Set in tests to an isolated temp dir.
# DATA_DIR=data

# Override the directory where PDF uploads are stored.
# Defaults to "data/uploads/" (relative to project root).
# UPLOADS_DIR=data/uploads

# Auth stub: set this to a user ID to bypass session auth in development / integration tests.
# NEVER set this in production — leave unset so real session auth (issue #2) applies.
# TEST_USER_ID=dev-user-1
