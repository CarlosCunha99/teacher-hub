# Application environment
# Copy this file to .env.local and fill in real values before running locally.
# .env.local is gitignored and must never be committed.

APP_ENV=development

# NextAuth — copy to .env.local and replace with a real secret before running
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000

# Database connection (added in issue #3 — PostgreSQL schema)
# DATABASE_URL=******localhost:5432/teacher_hub
