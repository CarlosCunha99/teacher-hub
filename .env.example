# Application environment
# Copy this file to .env.local and fill in real values before running locally.
# .env.local is gitignored and must never be committed.
# Real variables for database, authentication, etc. arrive in issues #2 and #3.

APP_ENV=development

# Database connection (added in issue #3 — PostgreSQL schema)
# DATABASE_URL=postgresql://user:password@localhost:5432/teacher_hub

# Billing (Stripe) — premium membership (issue #15)
# Secret API key from the Stripe dashboard (Developers → API keys).
STRIPE_SECRET_KEY=
# Signing secret for webhook events (Developers → Webhooks, or `stripe listen`).
STRIPE_WEBHOOK_SECRET=
# Price ID of the premium monthly plan (Products → your price).
STRIPE_PRICE_ID=
# Base URL used to build Stripe success/cancel redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
