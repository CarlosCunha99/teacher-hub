# Application environment
# Copy this file to .env.local and fill in real values before running locally.
# .env.local is gitignored and must never be committed.
# Real variables for authentication arrive in issue #2.

APP_ENV=development

# Database connection (added in issue #3 — PostgreSQL schema)
# Format: postgresql://[user[:password]@]host[:port]/dbname
DATABASE_URL=******localhost:5432/teacher_hub
